<?xml version="1.0" encoding="utf-8"?>
<!-- Round focus for channel avatars: a 3 dp purple ring with a 1 dp white line inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="@color/purple" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
