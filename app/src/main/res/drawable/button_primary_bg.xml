<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_gold_light" />
            <stroke android:width="2dp" android:color="@color/focus_gold_on_light" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="@color/accent_yellow"
                android:endColor="@color/accent_gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
