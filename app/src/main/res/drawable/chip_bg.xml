<?xml version="1.0" encoding="utf-8"?>
<!-- A recent-search chip: a raised pill; focused, a white pill inside a 2 dp purple ring with a gap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/purple" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/text" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/surface_raised" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
