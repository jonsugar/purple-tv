<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple">#9146FF</color>
    <color name="purple_light">#BF94FF</color>
    <color name="background">#0E0E10</color>
    <color name="surface">#18181B</color>
    <color name="surface_raised">#26262C</color>
    <color name="border">#2F2F35</color>
    <color name="live_red">#EB0400</color>
    <color name="text">#EFEFF1</color>
    <color name="text_soft">#DEDEE3</color>
    <color name="text_secondary">#ADADB8</color>
    <!-- Sampled from the official Twitch TV app's player overlay. -->
    <color name="focus_purple">#772CE8</color>
    <color name="overlay_dim">#99000000</color>
    <color name="viewers_pink">#FF8280</color>

    <style name="Theme.PurpleTV" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- The sign-out confirmation: the system dialog in the app's colours, font and buttons. -->
    <style name="PurpleDialog" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/button_outline_bg</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
