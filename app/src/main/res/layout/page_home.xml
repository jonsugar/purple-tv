<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the focused card large at the top (the hero), the rows below in one list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/hero_backdrop_a"
        android:layout_width="680dp"
        android:layout_height="383dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/hero_backdrop_b"
        android:layout_width="680dp"
        android:layout_height="383dp"
        android:layout_gravity="top|end"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="680dp"
        android:layout_height="383dp"
        android:layout_gravity="top|end"
        android:background="@drawable/hero_scrim_side" />

    <View
        android:layout_width="match_parent"
        android:layout_height="194dp"
        android:layout_marginTop="190dp"
        android:background="@drawable/hero_scrim_bottom" />


    <LinearLayout
        android:id="@+id/hero_block"
        android:layout_width="430dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="60dp"
        android:orientation="vertical"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/live_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/live"
                android:textColor="#FFFFFF"
                android:textFontWeight="800"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hero_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text_soft"
                android:textFontWeight="500"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:letterSpacing="-0.015"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textFontWeight="800"
            android:textSize="28sp" />

        <LinearLayout
            android:id="@+id/hero_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hero_avatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/avatar_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hero_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textFontWeight="700"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hero_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hero_viewers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/viewers_pink"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="280dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="22dp"
        android:paddingBottom="200dp"
        android:scrollbars="none" />
</FrameLayout>
