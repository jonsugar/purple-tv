<?xml version="1.0" encoding="utf-8"?>
<!-- The Channels strip: the channels of the row the stream came from, under the overlay's details.
     The list's own start padding leaves room for the focused card to grow: the stage clips the strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zap_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="36dp"
    android:layout_marginBottom="16dp"
    android:clipChildren="false"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/zap_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textFontWeight="700"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zap_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingEnd="44dp"
        android:paddingVertical="4dp" />
</LinearLayout>
