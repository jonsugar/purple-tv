<?xml version="1.0" encoding="utf-8"?>
<com.purpletv.ui.NavContentLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">
    <!-- No background: the theme's window background is the same colour, and a second
         full-screen fill costs this TV's GPU on every frame. -->

    <include layout="@layout/view_nav_rail" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/surface_raised" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false" />
</com.purpletv.ui.NavContentLayout>
