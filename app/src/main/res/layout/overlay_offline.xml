<?xml version="1.0" encoding="utf-8"?>
<!-- The page for an offline channel: who it is, and followed channels live to switch to. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="246dp"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/offline_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- With a picture, the Home hero's scrims keep the text readable and fade into the page. -->
        <View
            android:id="@+id/offline_scrim_side"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_scrim_side"
            android:visibility="gone" />

        <View
            android:id="@+id/offline_scrim_bottom"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/hero_scrim_bottom"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="66dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="106dp">

            <ImageView
                android:id="@+id/offline_avatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/avatar_bg"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/offline_badge"
                android:letterSpacing="0.02"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="@string/offline_badge"
                android:textColor="@color/text_soft"
                android:textFontWeight="800"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="64dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/offline_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.015"
                android:singleLine="true"
                android:textFontWeight="800"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.15"
                android:maxWidth="380dp"
                android:text="@string/offline_sub"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/offline_row"
        layout="@layout/view_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="54dp"
        android:layout_marginTop="258dp" />
</FrameLayout>
