<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="106dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/ch_ring"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:padding="5dp">

            <FrameLayout
                android:id="@+id/ch_border"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/avatar_ring_off"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/ch_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/ch_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/live_badge"
                android:paddingHorizontal="4.5dp"
                android:paddingVertical="2dp"
                android:text="@string/live"
                android:textColor="#FFFFFF"
                android:textFontWeight="700"
                android:textSize="9sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/ch_name"
            android:minHeight="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textFontWeight="600"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/ch_sub"
            android:minHeight="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</merge>
