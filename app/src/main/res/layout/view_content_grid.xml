<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:clipChildren="false">
    <TextView android:id="@+id/content_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_marginTop="10dp" android:textSize="11sp" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/content_retry" style="@style/Tab" android:layout_marginStart="4dp"
        android:text="@string/retry" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/content_grid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="6dp" android:paddingTop="8dp" android:paddingBottom="40dp" android:overScrollMode="never" />
</LinearLayout>
