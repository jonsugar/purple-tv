<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_gravity="bottom"
    android:background="#E60E0E10"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="32dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/info_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/avatar_ring_live"
        android:importantForAccessibility="no"
        android:padding="2dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/info_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textFontWeight="700"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/live_badge"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1.5dp"
                android:text="@string/live"
                android:textColor="#FFFFFF"
                android:textFontWeight="700"
                android:textSize="7.5sp" />

            <TextView
                android:id="@+id/info_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textFontWeight="500"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/info_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/purple_light"
            android:textFontWeight="600"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/quality_chip"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:textFontWeight="700"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/info_hints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/player_hints"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
