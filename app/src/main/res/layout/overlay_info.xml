<?xml version="1.0" encoding="utf-8"?>
<!-- The player overlay, laid out like the official Twitch TV app (its 1080p screen halved into dp). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_scrim"
    android:visibility="gone">

    <TextView
        android:id="@+id/overlay_back"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="36dp"
        android:layout_marginTop="27dp"
        android:background="@drawable/overlay_button_bg"
        android:clickable="true"
        android:drawableStart="@drawable/ic_back"
        android:drawablePadding="8dp"
        android:drawableTint="@color/overlay_content"
        android:focusable="true"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:text="@string/player_back"
        android:textColor="@color/overlay_content"
        android:textFontWeight="600"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/info_avatar_frame"
        android:layout_width="56dp"
        android:layout_height="65dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="37dp"
        android:layout_marginBottom="41dp">

        <ImageView
            android:id="@+id/info_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/avatar_bg"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/live_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp"
            android:text="@string/live"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="11sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/info_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="112dp"
        android:layout_marginEnd="250dp"
        android:layout_marginBottom="55dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/info_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textFontWeight="600"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textFontWeight="700"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/info_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/overlay_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="35dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/overlay_quality"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/overlay_icon_bg"
            android:clickable="true"
            android:contentDescription="@string/quality_title"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/overlay_content" />

        <ImageView
            android:id="@+id/overlay_chat"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="17dp"
            android:background="@drawable/overlay_icon_bg"
            android:clickable="true"
            android:contentDescription="@string/chat_title"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_chat_panel"
            android:tint="@color/overlay_content" />

        <ImageView
            android:id="@+id/overlay_zap"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="17dp"
            android:background="@drawable/overlay_icon_bg"
            android:clickable="true"
            android:contentDescription="@string/zap_button"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_channels"
            android:tint="@color/overlay_content" />
    </LinearLayout>
</FrameLayout>
