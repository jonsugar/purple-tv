<?xml version="1.0" encoding="utf-8"?>
<!-- The tune-in: the opened card's picture and details until the first video frame. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tune_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <ImageView
        android:id="@+id/tune_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tune_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="54dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="68dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/avatar_ring_live"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/tune_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/avatar_bg"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/live_badge"
                android:letterSpacing="0.02"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/live"
                android:textColor="#FFFFFF"
                android:textFontWeight="800"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="168dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tune_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textFontWeight="700"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tune_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:letterSpacing="-0.012"
                android:maxLines="2"
                android:textFontWeight="800"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tune_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:indeterminate="true"
            android:indeterminateTint="@color/purple"
            android:maxHeight="3dp"
            android:minHeight="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/tune_label"
            android:textColor="@color/text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
