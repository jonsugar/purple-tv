<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="204dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/card_ring"
            android:layout_width="204dp"
            android:layout_height="118dp"
            android:padding="4dp">

            <FrameLayout
                android:id="@+id/card_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/thumb_bg">

                <ImageView
                    android:id="@+id/card_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="6dp"
                    android:background="@drawable/live_badge"
                    android:paddingHorizontal="4.5dp"
                    android:paddingVertical="2dp"
                    android:text="@string/live"
                    android:textColor="#FFFFFF"
                    android:textFontWeight="700"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/card_viewers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="6dp"
                    android:background="@drawable/viewer_pill"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="2dp"
                    android:textColor="#FFFFFF"
                    android:textFontWeight="500"
                    android:textSize="9sp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/card_avatar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/avatar_bg"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_title"
                    android:minHeight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textFontWeight="600"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/card_name"
                    android:minHeight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textFontWeight="500"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/card_game"
                    android:minHeight="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
