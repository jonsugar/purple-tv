<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/debug_indicator"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|end"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/panel_bg"
    android:elevation="4dp"
    android:orientation="vertical"
    android:paddingStart="9dp"
    android:paddingEnd="9dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_debug"
        android:drawablePadding="5dp"
        android:gravity="center_vertical"
        android:text="@string/debug_badge"
        android:textColor="@color/accent_gold_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/debug_flag_networking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/debug_networking_disabled"
        android:textColor="@color/text"
        android:textSize="11sp" />
</LinearLayout>
