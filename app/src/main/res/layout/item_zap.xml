<?xml version="1.0" encoding="utf-8"?>
<!-- One channel in the Channels strip; the 4 dp around the picture hold the focus ring. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/zap_ring"
        android:layout_width="168dp"
        android:layout_height="98dp"
        android:padding="4dp">

        <FrameLayout
            android:id="@+id/zap_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/thumb_bg">

            <ImageView
                android:id="@+id/zap_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/zap_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="104dp"
            android:singleLine="true"
            android:textColor="@color/text_soft"
            android:textFontWeight="600"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/zap_on_air"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:text="@string/zap_on_air"
            android:textColor="@color/accent_gold_light"
            android:textFontWeight="600"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
