<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <Switch
        android:id="@+id/debug_enabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nav_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="44dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/debug_enable"
        android:textSize="13sp" />

    <Switch
        android:id="@+id/debug_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nav_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="44dp"
        android:nextFocusUp="@id/debug_enabled"
        android:nextFocusDown="@android:id/button1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/debug_disable_networking"
        android:textSize="13sp" />

</LinearLayout>
