<?xml version="1.0" encoding="utf-8"?>
<!-- One recent search. The 4 dp around the pill hold the focus ring, so focus never moves the row. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="2dp"
    android:background="@drawable/chip_bg"
    android:clickable="true"
    android:drawableStart="@drawable/ic_recent"
    android:drawablePadding="7dp"
    android:drawableTint="@color/chip_icon"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="11dp"
    android:singleLine="true"
    android:textColor="@color/chip_text"
    android:textFontWeight="600"
    android:textSize="13sp" />
