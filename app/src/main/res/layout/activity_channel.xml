<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <ImageView android:id="@+id/channel_backdrop" android:layout_width="match_parent" android:layout_height="200dp"
        android:scaleType="centerCrop" android:alpha="0.45" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="200dp" android:background="@drawable/category_scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
        <include layout="@layout/view_nav_rail" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/surface_raised" />
        <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:fillViewport="true" android:clipChildren="false" android:clipToPadding="false" android:overScrollMode="never">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:clipChildren="false" android:paddingStart="22dp" android:paddingTop="26dp" android:paddingBottom="40dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginStart="10dp">
                    <ImageView android:id="@+id/channel_avatar" android:layout_width="52dp" android:layout_height="52dp"
                        android:background="@drawable/avatar_bg" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:id="@+id/channel_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="26sp" android:textFontWeight="800" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/channel_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/channel_watch_live" style="@style/Tab"
                        android:text="@string/watch_live" android:visibility="gone" />
                    <TextView android:id="@+id/channel_follow" style="@style/Tab" android:layout_marginStart="8dp"
                        android:text="@string/follow_loading" />
                    <TextView android:id="@+id/channel_ghost_follow" style="@style/Tab" android:layout_marginStart="8dp"
                        android:text="@string/ghost_follow" android:visibility="gone" />
                    <TextView android:id="@+id/channel_pin" style="@style/Tab" android:layout_marginStart="8dp"
                        android:text="@string/pin" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/channel_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:layout_marginTop="12dp" android:textSize="11sp" android:textColor="@color/text_secondary" android:text="@string/loading" />
                <TextView android:id="@+id/channel_retry" style="@style/Tab" android:layout_marginStart="4dp" android:text="@string/retry" android:visibility="gone" />
                <LinearLayout android:id="@+id/channel_sections" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:clipChildren="false" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp" android:text="@string/channel_videos" android:textSize="14sp" android:textFontWeight="700" />
                    <include android:id="@+id/channel_videos_row" layout="@layout/view_recording_row" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:layout_marginTop="14dp" android:text="@string/channel_clips" android:textSize="14sp" android:textFontWeight="700" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                        <TextView android:id="@+id/clips_day" style="@style/Tab" android:text="@string/clips_top_day" />
                        <TextView android:id="@+id/clips_week" style="@style/Tab" android:layout_marginStart="6dp" android:text="@string/clips_top_week" />
                        <TextView android:id="@+id/clips_month" style="@style/Tab" android:layout_marginStart="6dp" android:text="@string/clips_top_month" />
                        <TextView android:id="@+id/clips_all" style="@style/Tab" android:layout_marginStart="6dp" android:text="@string/clips_top_all" />
                    </LinearLayout>
                    <include android:id="@+id/channel_clips_row" layout="@layout/view_recording_row" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
