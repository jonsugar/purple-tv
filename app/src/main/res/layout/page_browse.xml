<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/nav_browse"
        android:textFontWeight="700"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_categories"
            style="@style/Tab"
            android:text="@string/tab_categories" />

        <TextView
            android:id="@+id/tab_live"
            style="@style/Tab"
            android:layout_marginStart="12dp"
            android:text="@string/tab_live" />

        <TextView
            android:id="@+id/browse_language"
            style="@style/Tab"
            android:layout_marginStart="12dp"
            android:nextFocusLeft="@id/tab_live"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/browse_results"
        layout="@layout/view_content_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />
</LinearLayout>
