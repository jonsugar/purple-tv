<?xml version="1.0" encoding="utf-8"?>
<!-- A category: its box art blurred behind the top, a large header, the rail, the live streams. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageView
        android:id="@+id/category_backdrop"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/category_scrim" />

    <com.purpletv.ui.NavContentLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <include layout="@layout/view_nav_rail" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/surface_raised" />

        <LinearLayout
            android:id="@id/content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="44dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/category_art_frame"
                    android:layout_width="104dp"
                    android:layout_height="139dp"
                    android:background="@drawable/thumb_bg">

                    <ImageView
                        android:id="@+id/category_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="32dp"
                    android:orientation="vertical"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/category_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="-0.02"
                        android:lineSpacingMultiplier="0.95"
                        android:maxLines="2"
                        android:textFontWeight="800"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/category_subtitle"
                        android:textColor="@color/text_soft"
                        android:textSize="13sp" />

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:id="@+id/category_follow" style="@style/Tab"
                            android:text="@string/follow_loading" />
                        <TextView android:id="@+id/category_pin" style="@style/Tab" android:layout_marginStart="8dp"
                            android:text="@string/pin" android:visibility="gone" />
                        <TextView android:id="@+id/category_language" style="@style/Tab" android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/category_results"
                layout="@layout/view_content_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="30dp"
                android:layout_weight="1" />
        </LinearLayout>
    </com.purpletv.ui.NavContentLayout>
</FrameLayout>
